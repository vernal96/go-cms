{
  "info": {
    "name": "GO CMS — Public menus and site settings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Публичное меню: Host выбирает сайт. ID родителей доступны в админке и в выводе make demo-start."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "domain",
      "value": "demo.localhost"
    },
    {
      "key": "projects_id",
      "value": "1049"
    },
    {
      "key": "footer1_id",
      "value": "1060"
    },
    {
      "key": "footer2_id",
      "value": "1063"
    }
  ],
  "item": [
    {
      "name": "Полное дерево",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{domain}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/menu"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('items array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Основное меню — один уровень",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{domain}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/menu?depth=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('items array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Меню проектов",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{domain}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/menu?parent_id={{projects_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('items array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Футер 1",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{domain}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/menu?parent_id={{footer1_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('items array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Футер 2",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{domain}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/menu?parent_id={{footer2_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('items array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Два уровня проектов",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{domain}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/menu?parent_id={{projects_id}}&depth=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('items array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Публичные параметры сайта",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Host",
            "value": "{{domain}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/site"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
              "pm.test('Only public demo settings', () => { const s = pm.response.json().settings; pm.expect(s).to.be.an('object'); pm.expect(s).to.have.property('string_value'); ['integer_value','float_value','checkbox_value','radio_value','select_value'].forEach(k => pm.expect(s).not.to.have.property(k)); });"
            ]
          }
        }
      ]
    }
  ]
}
