# Required project logger settings.
LOGGER_DRIVER=file
LOGGER_LEVEL=info
LOGGER_SERVICE_NAME=go-cms
LOGGER_ENVIRONMENT=dev

# File backend (used only when LOGGER_DRIVER=file).
LOGGER_FILE_PATH=var/log/cms.log
LOGGER_FILE_TIMEZONE=Local
LOGGER_FILE_MAX_SIZE=104857600
LOGGER_FILE_MAX_BACKUPS=14
LOGGER_FILE_MAX_AGE=336h
LOGGER_FILE_COMPRESS=true

# Loki backend (set LOGGER_DRIVER=loki to use it).
# LOGGER_LOKI_ENDPOINT=http://localhost:3100
LOGGER_LOKI_READINESS_TIMEOUT=5s
LOGGER_LOKI_EXPORT_TIMEOUT=5s
LOGGER_LOKI_SHUTDOWN_TIMEOUT=5s

# Required project event bus settings.
EVENT_BUS_DRIVER=kafka
EVENT_BUS_CONSUMER_RETRY_DELAY=1s
EVENT_BUS_SHUTDOWN_TIMEOUT=5s

# Kafka backend (selected by EVENT_BUS_DRIVER=kafka).
# Topics are managed outside the application and must exist before use.
EVENT_BUS_KAFKA_BROKERS=localhost:9092
EVENT_BUS_KAFKA_CLIENT_ID=go-cms
EVENT_BUS_KAFKA_USERNAME=
EVENT_BUS_KAFKA_PASSWORD=
EVENT_BUS_KAFKA_TLS_ENABLED=false
EVENT_BUS_KAFKA_TLS_SERVER_NAME=
EVENT_BUS_KAFKA_TLS_INSECURE=false
EVENT_BUS_KAFKA_DIAL_TIMEOUT=5s

# RabbitMQ backend (selected by EVENT_BUS_DRIVER=rabbitmq).
# The exchange and queues/bindings are managed outside the application.
# A subscription group maps directly to its durable RabbitMQ queue name.
EVENT_BUS_RABBITMQ_URL=amqp://cms:change-me@localhost:5672/cms
EVENT_BUS_RABBITMQ_EXCHANGE=cms.events
EVENT_BUS_RABBITMQ_DIAL_TIMEOUT=5s
EVENT_BUS_RABBITMQ_RECONNECT_ATTEMPTS=30
EVENT_BUS_RABBITMQ_RECONNECT_DELAY=1s

# Transactional outbox publisher.
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_DURATION=30s
OUTBOX_INITIAL_RETRY_DELAY=1s
OUTBOX_MAXIMUM_RETRY_DELAY=1h
OUTBOX_PUBLISHED_RETENTION=168h
OUTBOX_CLEANUP_INTERVAL=1h
OUTBOX_CLEANUP_MAX_BATCHES=100

# Site-scoped Mail module. Use log/null in development and smtp in deployed environments.
MAIL_TRANSPORT_DRIVER=log
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_TLS_ENABLED=true
MAIL_SMTP_TLS_SERVER_NAME=
MAIL_SMTP_TIMEOUT=10s
# If both are empty, Mail permits only the current site's domain.
MAIL_ALLOWED_SENDER_ADDRESSES=
MAIL_ALLOWED_SENDER_DOMAINS=
MAIL_MESSAGE_ID_DOMAIN=localhost
# Set to 0s to retain terminal Mail history indefinitely.
MAIL_HISTORY_RETENTION=720h
MAIL_HISTORY_CLEANUP_INTERVAL=1h
MAIL_HISTORY_CLEANUP_BATCH=100
MAIL_SEND_MAX_ATTEMPTS=5
MAIL_MAX_RECIPIENTS=100
MAIL_MAX_MESSAGE_SIZE=26214400
MAIL_MAX_ATTACHMENT_SIZE=20971520
MAIL_UPLOAD_STORAGE=private
MAIL_UPLOAD_PATH=mail
# Transient automatic attachments use a private Mail-owned filesystem binding.
MAIL_SPOOL_ENABLED=true
MAIL_SPOOL_TTL=24h
MAIL_SPOOL_CLEANUP_INTERVAL=1h
MAIL_SPOOL_CLEANUP_BATCH=100

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ADMIN_PORT=5173
ADMIN_API_TARGET=http://server:8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me
POSTGRES_SSL_MODE=disable

FILES_PUBLIC_DRIVER=local
FILES_PUBLIC_LOCAL_ROOT=var/files/public
FILES_PUBLIC_LOCAL_BASE_URL=http://localhost:8080
FILES_PUBLIC_LOCAL_SIGNING_KEY=

FILES_PRIVATE_DRIVER=local
FILES_PRIVATE_LOCAL_ROOT=var/files/private
FILES_PRIVATE_LOCAL_BASE_URL=http://localhost:8080
FILES_PRIVATE_LOCAL_SIGNING_KEY=replace-with-at-least-32-random-bytes
FILES_MAX_UPLOAD_SIZE=104857600
FILES_UPLOAD_TIMEOUT=10m
FILES_AVATAR_STORAGE=private
FILES_AVATAR_MAX_SIZE=5242880

CACHE_FILESYSTEM_STORAGE=private
CACHE_FILESYSTEM_PREFIX=cache/filesystem_cache

CACHE_REDIS_ADDRS=localhost:6379
CACHE_REDIS_PREFIX=cms:cache:redis_cache

JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_ISSUER=go-cms
JWT_AUDIENCE=go-cms-api
JWT_ACCESS_TTL=48h
JWT_CLOCK_SKEW=30s

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
